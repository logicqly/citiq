#!/bin/sh
# Export NGINX_LOCAL_RESOLVERS for the config template, unconditionally.
#
# nginx.conf.template needs a `resolver` directive so that proxy_pass can look
# the API host up per request instead of once at startup. The stock
# 15-local-resolvers.envsh in this image computes exactly that value, but only
# when NGINX_ENTRYPOINT_LOCAL_RESOLVERS is set, and otherwise returns early.
# If the variable is undefined, envsubst leaves `${NGINX_LOCAL_RESOLVERS}` in
# the config verbatim and nginx dies on a parse error, so relying on that gate
# would trade one startup crash for another.
#
# Sourced (not executed) by docker-entrypoint.sh, ahead of
# 20-envsubst-on-templates.sh, so the export is visible to envsubst.

# IPv6 nameservers have to be bracketed for the resolver directive. Railway's
# private network is IPv6, so this is the normal case there, not an edge case.
NGINX_LOCAL_RESOLVERS=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' /etc/resolv.conf)

# Fall back to Docker's embedded DNS if resolv.conf yielded nothing, so the
# directive is never empty.
[ -n "$NGINX_LOCAL_RESOLVERS" ] || NGINX_LOCAL_RESOLVERS="127.0.0.11"

export NGINX_LOCAL_RESOLVERS
