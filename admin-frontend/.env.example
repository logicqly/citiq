# Build-time variables — baked into the static bundle by Vite

# Admin API base URL.
VITE_API_URL=https://citiq-admin-api-production.up.railway.app

# Client dashboard origin, shown to staff in the credentials panel when they
# create a client user. Must be the URL clients actually log in at.
VITE_DASHBOARD_URL=https://citiq-web-production.up.railway.app
