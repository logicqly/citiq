server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/javascript;

    # HTTP Basic Auth — first layer of protection in front of the JWT layer
    auth_basic "Citiq Admin: Authorized Access Only";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Resolve the API host per request rather than once at startup.
    #
    # A literal hostname in proxy_pass is resolved when nginx parses the config,
    # and nginx exits with "host not found in upstream" if that lookup fails.
    # On Railway the API is reached over the private network, so a cold start
    # where api is not up yet, or any api redeploy, would take this container
    # down with it. Routing through a variable defers the lookup to request
    # time, which needs an explicit resolver.
    #
    # NGINX_LOCAL_RESOLVERS is written from /etc/resolv.conf by the image's
    # 15-local-resolvers entrypoint script, which runs before envsubst.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Proxy /api/* calls to the API service (strips the /api prefix)
    location /api/ {
        # Basic auth MUST NOT apply here. HTTP Basic and JWT Bearer share the
        # single Authorization header, and they cannot coexist: once the SPA
        # logs in, axios sets `Authorization: Bearer <jwt>` on every XHR, which
        # replaces the browser's `Authorization: Basic <credentials>`. auth_basic
        # then rejects the request and answers with WWW-Authenticate: Basic, so
        # the browser reopens the password dialog on every API call.
        #
        # Nothing is lost by turning it off. Every route behind here enforces
        # its own JWT, and the same API is already reachable without basic auth
        # through the client dashboard's /api/ proxy, so auth_basic was adding
        # no protection here, only the loop. It still guards the SPA itself
        # (the HTML, JS and assets) via the server-level directive above.
        auth_basic off;

        set $api_upstream ${API_HOST};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass         $api_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # SPA fallback — all other routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
