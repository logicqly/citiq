# ── Stage 1: build the React app ─────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --production=false
COPY . .

# Baked into the static bundle at build time. Set to /api so the browser calls
# this container's own nginx, which proxies to ${API_HOST} on the private
# network; the API then needs no public domain of its own.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Stage 2: serve with nginx ─────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

# Place config in /etc/nginx/templates/ — nginx auto-runs envsubst on startup,
# replacing ${API_HOST} with the environment variable value.
COPY nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
