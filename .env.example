# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=origo
POSTGRES_PASSWORD=change_me_use_a_strong_password
POSTGRES_DB=origo

# ── AI Platform API Keys ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...
GEMINI_API_KEY=AIza...

# ── App Config ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_CONCURRENT_PER_PLATFORM=3

# ── Per-platform rate limits (requests / minute) ──────────────────────────────
# Paces every upstream call (monitoring AND analysis) so a run cannot burst past
# a provider's per-minute cap. Defaults below are conservative; set the real
# per-tier ceilings from your provider dashboards to pace closer to the limit
# (no redeploy needed). A value <= 0 disables limiting for that platform.
PLATFORM_RATE_LIMIT_OPENAI=500
PLATFORM_RATE_LIMIT_ANTHROPIC=500
PLATFORM_RATE_LIMIT_PERPLEXITY=50
PLATFORM_RATE_LIMIT_GEMINI=60
# Longest a single call waits for a rate-limit slot before proceeding anyway
# (fail-open safety valve; a compliant 100-prompt run's slowest call waits only
# ~1-2 windows).
PLATFORM_RATE_LIMIT_MAX_WAIT_SECONDS=300

# ── Call timeouts & dropped-call retries ──────────────────────────────────────
# Per-call ceiling for a plain (ungrounded) LLM request; one hung call must not
# stall a run.
PLATFORM_CALL_TIMEOUT_SECONDS=90
# Ceiling for WEB-GROUNDED monitoring calls (OpenAI/Anthropic run multi-round
# server-side search loops; Perplexity sonar is always grounded). Effective
# grounded timeout = max(plain, grounded).
PLATFORM_CALL_TIMEOUT_GROUNDED_SECONDS=240
# Failed/timed-out monitoring calls are re-run in up to this many extra passes
# after the first wave (0 disables). Pass N waits N × the backoff first.
MONITORING_RETRY_PASSES=2
MONITORING_RETRY_BACKOFF_SECONDS=10
# Responses whose citation-analysis call failed are retried this many extra
# times before being counted as analysis drops (0 disables). 10 per the
# 2026-07-25 client agreement: the safety net for the one response that fails
# on almost every run. Only failures are retried, so the cost is negligible.
ANALYSIS_RETRY_PASSES=10
# Ceiling on ONE citation-analysis attempt, decoupled from the monitoring
# timeout: each attempt gets generous headroom because the retries above, not
# a longer wait, are the recovery mechanism.
ANALYSIS_CALL_TIMEOUT_SECONDS=120

# ── Web grounding ─────────────────────────────────────────────────────────────
# The monitoring platforms must answer from the LIVE web, not from training
# data, or the citation rate measures what a model remembers instead of what a
# buyer would actually be told.
WEB_GROUNDING_ENABLED=true
# Web searches allowed per call. Was 5, which Claude exhausted on multi-part
# comparison queries ("Fleetio or Samsara for a construction fleet?"): the tool
# returned max_uses_exceeded and the answer was finished from memory.
WEB_SEARCH_MAX_USES=12
# Treat "was told to search, cited nothing" as a failure rather than a result.
# Such a response is retried and, if it still cites nothing, recorded as
# ungrounded and excluded from every citation figure. Turning this off restores
# the old silent behaviour and should only ever be temporary.
WEB_GROUNDING_REQUIRE_SOURCES=true
WEB_GROUNDING_RETRY_ATTEMPTS=2
# One shared system prompt across all four platforms, framing each prompt as a
# real buying question. Without it the agentic models read a product-shaped
# prompt ("Fleet inspection app for an oil and gas company") as a request to
# BUILD one and reply with a plan, citing nobody.
PLATFORM_SYSTEM_PROMPT_ENABLED=true
# Anthropic is the only adapter that sends an output cap. 2048 was not enough
# to run several searches and still write a full answer.
ANTHROPIC_MAX_OUTPUT_TOKENS=8192

# ── Recommendation engine ─────────────────────────────────────────────────────
# "single_call" (default): one LLM call receives every response carrying a
# citation gap, grouped into clusters by the client's service lines and ordered
# by their commercial tier, and decides what to produce. "legacy": the old
# per-analysis fan-out, kept as a rollback path for one release.
#
# There is no top-N setting any more. Ranking by opportunity score selected for
# winnable over important, so nothing is cut: every gap response is sent, and
# the knowledge base's service tiers decide emphasis.
RECOMMENDATION_MODE=single_call
# Chars of each response sent to that call. 0 (the default) means NO LIMIT and
# is the correct setting. Any non-zero value truncates responses from the front
# and reintroduces a real defect: responses run 3-6k chars and the brand and
# competitor mentions in ranked answers sit mid-to-late, so a cap here removes
# exactly the evidence the stage exists to reason about. Temporary cost control
# only, and it logs a warning on every run while set.
RECOMMENDATION_RESPONSE_MAX_CHARS=0
# The single call is legitimately slow (large input, large output).
RECOMMENDATION_CALL_TIMEOUT_SECONDS=600
# Input-token ceiling for the assembled prompt, sized for a large-context
# recommendation model (Gemini 3.1 Pro and similar). The limit actually applied
# is the smaller of this and what the configured model's own context window
# allows once output is reserved, so a client left on a 128k model is clamped
# automatically rather than failing on context length.
RECOMMENDATION_INPUT_TOKEN_BUDGET=900000
# Output ceiling for the one call that emits every recommendation for the run.
# "One brief per distinct gap" makes this a long completion.
RECOMMENDATION_MAX_OUTPUT_TOKENS=32000

# ── Live site inventory (recommendation input) ────────────────────────────────
# Reads the client's own website so implemented work is never re-recommended.
# Failure is never fatal — generation proceeds saying "no live site data".
SITE_INVENTORY_ENABLED=true
SITE_INVENTORY_MAX_PAGES=30
SITE_INVENTORY_TTL_HOURS=24

# ── Public /v1 Audit API auth ─────────────────────────────────────────────────
# Per-environment API keys for the /v1 automation surface, sent by callers as
# `X-API-Key: <key>`. Comma-separated; each entry is a bare key or `label:key`
# (the label is logged on success, never the key). Multiple keys are valid at
# once — that is the rotation path: add the new key, migrate callers, then drop
# the old one, all by editing this secret (no code change, no rebuild).
# Empty = /v1 is disabled (every request gets 401 — fail closed).
AUDIT_API_KEYS=primary:change_me_generate_a_strong_random_key
